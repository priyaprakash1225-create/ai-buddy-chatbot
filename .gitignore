# ── Node.js ──────────────────────────────────────────────────────────────────
# Never commit installed packages — they are recreated with `npm install`
node_modules/

# ── Environment / Secrets ─────────────────────────────────────────────────────
# .env files contain API keys and passwords — NEVER commit these
.env
.env.local
.env.*.local

# ── Build output ──────────────────────────────────────────────────────────────
# Generated by `npm run build` — not needed in source control
dist/
build/

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store          # macOS folder metadata
Thumbs.db          # Windows thumbnail cache

# ── Editor files ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
*.log
